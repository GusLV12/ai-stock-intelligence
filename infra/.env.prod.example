# Copia a infra/.env.prod y rellena. NUNCA subas ese archivo ni lo pegues en chats o tickets.
# Genera los secretos con:  python -c "import secrets; print(secrets.token_urlsafe(64))"

APP_DOMAIN=asi.tudominio.com
MCP_DOMAIN=mcp.tudominio.com

DJANGO_SECRET_KEY=
DB_NAME=asi
DB_USER=asi
DB_PASSWORD=

# Respaldos cifrados: genera la clave con `python manage.py generate_backup_key` y guárdala TAMBIÉN en tu gestor de contraseñas.
BACKUP_KEY=
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# MCP remoto (perfil `mcp`): tu proveedor de identidad (Keycloak, Authentik, Auth0, Entra…). Debe ser https.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=

# Proveedores de datos (opcionales).
TWELVE_DATA_API_KEY=
BANXICO_TOKEN=
