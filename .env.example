# Copia a .env y ajusta. Nunca subas .env al repositorio.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (si DB_HOST está vacío, el backend usa SQLite solo para pruebas rápidas)
DB_HOST=
DB_PORT=5432
DB_NAME=asi
DB_USER=asi
DB_PASSWORD=cambia-esto

# Modo Demo (datos ficticios; solo con DJANGO_DEBUG=true). Usa una base aparte:
#   SQLITE_PATH=demo.sqlite3 python manage.py migrate && python manage.py seed_demo
SQLITE_PATH=
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-local-no-usar-en-produccion

# Datos de mercado (opcional). Crea tus propias claves; nunca las subas al repositorio.
# Twelve Data: https://twelvedata.com (plan gratuito; con retraso y limite por minuto)
TWELVE_DATA_API_KEY=
TWELVE_DATA_PER_MINUTE=8
# Banxico SIE: token gratuito en https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=
# Actualizar: cd apps/backend && python manage.py refresh_market_data

# SEC EDGAR (estados financieros gratuitos). La SEC exige identificar al solicitante en cada consulta: tu nombre y un correo.
# Se envía a los servidores de la SEC; usa uno que aceptes compartir. Ejemplo: SEC_CONTACT="Nombre Apellido correo@dominio"
# Importar: cd apps/backend && python manage.py ingest_sec_financials --held
SEC_CONTACT=
