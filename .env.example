# Copia a .env y ajusta. Nunca subas .env al repositorio.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (si DB_HOST está vacío, el backend usa SQLite solo para pruebas rápidas)
DB_HOST=
DB_PORT=5432
DB_NAME=asi
DB_USER=asi
DB_PASSWORD=cambia-esto

# Modo Demo (datos ficticios; solo con DJANGO_DEBUG=true). Usa una base aparte:
#   SQLITE_PATH=demo.sqlite3 python manage.py migrate && python manage.py seed_demo
SQLITE_PATH=
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-local-no-usar-en-produccion
